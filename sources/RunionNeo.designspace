<?xml version='1.0' encoding='UTF-8'?>
<designspace format="5.0">
  <axes>
    <axis tag="wght" name="Weight" minimum="300" maximum="700" default="400">
      <labels>
        <label uservalue="300" name="Light"/>
        <label uservalue="400" name="Regular" elidable="true" linkeduservalue="700"/>
        <label uservalue="500" name="Medium"/>
        <label uservalue="600" name="SemiBold"/>
        <label uservalue="700" name="Bold"/>
      </labels>
    </axis>
  </axes>
  <sources>
    <source filename="RunionNeo-Light.ufo" name="Light" familyname="Runion Neo" stylename="Light">
      <location>
        <dimension name="Weight" xvalue="300"/>
      </location>
    </source>
    <source filename="RunionNeo-Regular.ufo" name="Regular" familyname="Runion Neo" stylename="Regular">
      <location>
        <dimension name="Weight" xvalue="400"/>
      </location>
    </source>
    <source filename="RunionNeo-Bold.ufo" name="Bold" familyname="Runion Neo" stylename="Bold">
      <location>
        <dimension name="Weight" xvalue="700"/>
      </location>
    </source>
  </sources>
  <instances>
    <instance name="Light" familyname="Runion Neo" stylename="Light" filename="instances/RunionNeo-Light.ufo">
      <location>
        <dimension name="Weight" xvalue="300"/>
      </location>
    </instance>
    <instance name="Regular" familyname="Runion Neo" stylename="Regular" filename="instances/RunionNeo-Regular.ufo">
      <location>
        <dimension name="Weight" xvalue="400"/>
      </location>
    </instance>
    <instance name="Medium" familyname="Runion Neo" stylename="Medium" filename="instances/RunionNeo-Medium.ufo">
      <location>
        <dimension name="Weight" xvalue="500"/>
      </location>
    </instance>
    <instance name="SemiBold" familyname="Runion Neo" stylename="SemiBold" filename="instances/RunionNeo-SemiBold.ufo">
      <location>
        <dimension name="Weight" xvalue="600"/>
      </location>
    </instance>
    <instance name="Bold" familyname="Runion Neo" stylename="Bold" filename="instances/RunionNeo-Bold.ufo">
      <location>
        <dimension name="Weight" xvalue="700"/>
      </location>
    </instance>
  </instances>
</designspace>
